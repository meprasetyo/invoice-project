# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── Dependencies ──────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# ── Next.js ───────────────────────────────────────────────────────────────────
/.next/
/out/
/build

# ── Environment variables (berisi secrets, jangan di-commit) ──────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production

# ── Testing ───────────────────────────────────────────────────────────────────
/coverage

# ── Debug logs ────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS files ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem

# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Vercel ────────────────────────────────────────────────────────────────────
.vercel

# ── Drizzle generated (keep schema, ignore snapshots jika tidak diperlukan) ───
# drizzle/meta  ← uncomment kalau tidak mau commit migration metadata

# ── Editor ────────────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ── Misc ──────────────────────────────────────────────────────────────────────
*.zip
*.tar.gz
